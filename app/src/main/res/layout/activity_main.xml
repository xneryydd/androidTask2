<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 第一行 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="1,1"
                android:gravity="center"
                android:textColor="#000000"
                android:background="@drawable/rect_bg"/>

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="1,2"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="1,3"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="1,4"
                android:textColor="#000000"
                android:padding="4dp"
                android:background="@drawable/rect_bg"/>
        </LinearLayout>

        <!-- 第二行 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="2,1"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="2,2"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="2,3"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="2,4"
                android:textColor="#000000"
                android:padding="4dp"
                android:background="@drawable/rect_bg"/>
        </LinearLayout>

        <!-- 第三行 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="3,1"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="3,2"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="3,3"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="3,4"
                android:textColor="#000000"
                android:padding="4dp"
                android:background="@drawable/rect_bg"/>
        </LinearLayout>

        <!-- 第四行 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="4,1"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="4,2"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="4,3"
                android:textColor="#000000"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rect_bg"/>
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="4,4"
                android:textColor="#000000"
                android:padding="4dp"
                android:background="@drawable/rect_bg"/>




        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_to_first"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:text="跳转到 First"/>
        </LinearLayout>
    </LinearLayout>



</ScrollView>
